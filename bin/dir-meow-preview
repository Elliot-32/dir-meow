#!/usr/bin/env zsh

emulate -L zsh
setopt localoptions pipefail

_dir_meow_config_file() {
  local config_home=${XDG_CONFIG_HOME:-}

  # XDG_CONFIG_HOME must be absolute. Fall back to the XDG default otherwise.
  if [[ -z $config_home || $config_home != /* ]]; then
    config_home=$HOME/.config
  fi

  print -r -- "$config_home/dir-meow/config"
}

_dir_meow_eza_config() {
  local config_file=$(_dir_meow_config_file)
  local -A file_config
  local line key value

  if [[ -e $config_file ]]; then
    if [[ ! -r $config_file ]]; then
      print -r -- "dir-meow: config is not readable: $config_file"
      return 1
    fi

    while IFS= read -r line || [[ -n $line ]]; do
      # The file is intentionally not sourced. Strip comments and whitespace,
      # then parse the small key=value format ourselves.
      line=${line%%\#*}
      line=${line//[[:space:]]/}
      [[ -z $line ]] && continue

      if [[ $line != *=* ]]; then
        print -r -- "dir-meow: invalid config line: $line"
        return 1
      fi

      key=${line%%=*}
      value=${line#*=}

      case $key in
        icons|tree|level)
          file_config[$key]=$value
          ;;
        *)
          print -r -- "dir-meow: unknown config key: $key"
          return 1
          ;;
      esac
    done < "$config_file"
  fi

  local icons tree level

  if (( ${+DIR_MEOW_EZA_ICONS} )); then
    icons=$DIR_MEOW_EZA_ICONS
  elif (( ${+file_config[icons]} )); then
    icons=$file_config[icons]
  else
    icons=true
  fi

  if (( ${+DIR_MEOW_EZA_TREE} )); then
    tree=$DIR_MEOW_EZA_TREE
  elif (( ${+file_config[tree]} )); then
    tree=$file_config[tree]
  else
    tree=true
  fi

  if (( ${+DIR_MEOW_EZA_LEVEL} )); then
    level=$DIR_MEOW_EZA_LEVEL
  elif (( ${+file_config[level]} )); then
    level=$file_config[level]
  else
    level=2
  fi

  if [[ $icons != true && $icons != false ]]; then
    print -r -- 'dir-meow: icons must be true or false'
    return 1
  fi

  if [[ $tree != true && $tree != false ]]; then
    print -r -- 'dir-meow: tree must be true or false'
    return 1
  fi

  if [[ $level != <1-> ]]; then
    print -r -- 'dir-meow: level must be a positive integer'
    return 1
  fi

  print -r -- "$icons"
  print -r -- "$tree"
  print -r -- "$level"
}

_dir_meow_mode() {
  local state_file=$1
  local mode=atuin

  if [[ -r $state_file ]]; then
    IFS= read -r mode < "$state_file"
  fi

  [[ $mode == eza ]] || mode=atuin
  print -r -- "$mode"
}

_dir_meow_toggle() {
  local state_file=$1
  local mode=$(_dir_meow_mode "$state_file")

  if [[ $mode == atuin ]]; then
    print -r -- eza >| "$state_file"
  else
    print -r -- atuin >| "$state_file"
  fi
}

_dir_meow_label() {
  case $(_dir_meow_mode "$1") in
    eza)   print -r -- ' eza ' ;;
    atuin) print -r -- ' Atuin ' ;;
  esac
}

_dir_meow_preview_atuin() {
  local dir=$1

  if (( ! $+commands[atuin] )); then
    print -r -- 'dir-meow: atuin is not installed'
    return 0
  fi

  if [[ -z ${ATUIN_SESSION:-} ]]; then
    print -r -- 'dir-meow: ATUIN_SESSION is not set'
    return 0
  fi

  (
    builtin cd -- "$dir" || return
    command atuin history list --session --cwd --cmd-only
  )
}

_dir_meow_preview_eza() {
  local dir=$1

  if (( ! $+commands[eza] )); then
    print -r -- 'dir-meow: eza is not installed'
    return 0
  fi

  local config_output
  config_output=$(_dir_meow_eza_config) || {
    print -r -- "$config_output"
    return 0
  }

  local -a config
  config=("${(@f)config_output}")

  local icons=$config[1]
  local tree=$config[2]
  local level=$config[3]

  local -a args
  args=(--all --long --group-directories-first --color=always)

  # fzf preview output is not necessarily attached directly to a TTY, so make
  # the enabled setting deterministic instead of relying on eza's auto mode.
  [[ $icons == true ]] && args+=(--icons=always)

  if [[ $tree == true ]]; then
    args+=(--tree "--level=$level")
  fi

  command eza "${args[@]}" -- "$dir"
}

case ${1:-} in
  preview)
    (( $# == 3 )) || exit 2
    case $(_dir_meow_mode "$2") in
      eza)   _dir_meow_preview_eza "$3" ;;
      atuin) _dir_meow_preview_atuin "$3" ;;
    esac
    ;;
  toggle)
    (( $# == 2 )) || exit 2
    _dir_meow_toggle "$2"
    ;;
  label)
    (( $# == 2 )) || exit 2
    _dir_meow_label "$2"
    ;;
  *)
    print -u2 -r -- 'usage: dir-meow-preview {preview|toggle|label} ...'
    exit 2
    ;;
esac
