#!/usr/bin/env zsh

emulate -L zsh
setopt localoptions pipefail

_dir_meow_config_file() {
  local config_home=${XDG_CONFIG_HOME:-}

  # XDG_CONFIG_HOME must be absolute. Fall back to the XDG default otherwise.
  if [[ -z $config_home || $config_home != /* ]]; then
    config_home=$HOME/.config
  fi

  print -r -- "$config_home/dir-meow/config"
}

_dir_meow_ensure_config() {
  local config_file=$1
  local config_dir=${config_file:h}

  [[ -e $config_file ]] && return 0

  command mkdir -p -- "$config_dir" || {
    print -r -- "dir-meow: failed to create config directory: $config_dir"
    return 1
  }

  # NOCLOBBER prevents a concurrent dir-meow process from overwriting a config
  # that appeared between the existence check and this write.
  if [[ ! -e $config_file ]]; then
    (
      setopt localoptions noclobber
      {
        print -r -- 'icons=true'
        print -r -- 'tree=true'
        print -r -- 'level=2'
        print -r -- 'hidden=true'
      } > "$config_file"
    ) 2>/dev/null || {
      [[ -e $config_file ]] || {
        print -r -- "dir-meow: failed to create config: $config_file"
        return 1
      }
    }
  fi
}

_dir_meow_eza_config() {
  local config_file=$(_dir_meow_config_file)
  local -A file_config
  local line key value

  _dir_meow_ensure_config "$config_file" || return 1

  if [[ ! -r $config_file ]]; then
    print -r -- "dir-meow: config is not readable: $config_file"
    return 1
  fi

  while IFS= read -r line || [[ -n $line ]]; do
    # The file is intentionally not sourced. Strip comments and whitespace,
    # then parse the small key=value format ourselves.
    line=${line%%\#*}
    line=${line//[[:space:]]/}
    [[ -z $line ]] && continue

    if [[ $line != *=* ]]; then
      print -r -- "dir-meow: invalid config line: $line"
      return 1
    fi

    key=${line%%=*}
    value=${line#*=}

    case $key in
      icons|tree|level|hidden)
        file_config[$key]=$value
        ;;
      *)
        print -r -- "dir-meow: unknown config key: $key"
        return 1
        ;;
    esac
  done < "$config_file"

  local icons tree level hidden

  if (( ${+MEOW_ICONS} )); then
    icons=$MEOW_ICONS
  elif (( ${+file_config[icons]} )); then
    icons=$file_config[icons]
  else
    icons=true
  fi

  if (( ${+MEOW_TREE} )); then
    tree=$MEOW_TREE
  elif (( ${+file_config[tree]} )); then
    tree=$file_config[tree]
  else
    tree=true
  fi

  if (( ${+MEOW_LEVEL} )); then
    level=$MEOW_LEVEL
  elif (( ${+file_config[level]} )); then
    level=$file_config[level]
  else
    level=2
  fi

  if (( ${+MEOW_HIDDEN} )); then
    hidden=$MEOW_HIDDEN
  elif (( ${+file_config[hidden]} )); then
    hidden=$file_config[hidden]
  else
    hidden=true
  fi

  if [[ $icons != true && $icons != false ]]; then
    print -r -- 'dir-meow: icons must be true or false'
    return 1
  fi

  if [[ $tree != true && $tree != false ]]; then
    print -r -- 'dir-meow: tree must be true or false'
    return 1
  fi

  if [[ $level != <1-> ]]; then
    print -r -- 'dir-meow: level must be a positive integer'
    return 1
  fi

  if [[ $hidden != true && $hidden != false ]]; then
    print -r -- 'dir-meow: hidden must be true or false'
    return 1
  fi

  print -r -- "$icons"
  print -r -- "$tree"
  print -r -- "$level"
  print -r -- "$hidden"
}

_dir_meow_state_get() {
  local state_file=$1
  local key=$2
  local default=$3
  local line

  if [[ -r $state_file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == "$key="* ]]; then
        print -r -- "${line#*=}"
        return 0
      fi
    done < "$state_file"
  fi

  print -r -- "$default"
}

_dir_meow_state_set() {
  local state_file=$1
  local key=$2
  local value=$3
  local tmp_file="${state_file}.tmp.$$"
  local line
  local found=false

  : >| "$tmp_file" || return 1

  if [[ -r $state_file ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == "$key="* ]]; then
        print -r -- "$key=$value" >> "$tmp_file"
        found=true
      else
        print -r -- "$line" >> "$tmp_file"
      fi
    done < "$state_file"
  fi

  [[ $found == true ]] || print -r -- "$key=$value" >> "$tmp_file"
  command mv -f -- "$tmp_file" "$state_file"
}

_dir_meow_mode() {
  local mode=$(_dir_meow_state_get "$1" mode atuin)
  [[ $mode == eza ]] || mode=atuin
  print -r -- "$mode"
}

_dir_meow_hidden() {
  local hidden=$(_dir_meow_state_get "$1" hidden true)
  [[ $hidden == false ]] || hidden=true
  print -r -- "$hidden"
}

_dir_meow_toggle_mode() {
  local state_file=$1
  local mode=$(_dir_meow_mode "$state_file")

  if [[ $mode == atuin ]]; then
    _dir_meow_state_set "$state_file" mode eza
  else
    _dir_meow_state_set "$state_file" mode atuin
  fi
}

_dir_meow_toggle_hidden() {
  local state_file=$1

  # Hidden-file toggling belongs to the eza preview only. In Atuin mode this is
  # deliberately a no-op and never switches preview providers.
  [[ $(_dir_meow_mode "$state_file") == eza ]] || return 0

  if [[ $(_dir_meow_hidden "$state_file") == true ]]; then
    _dir_meow_state_set "$state_file" hidden false
  else
    _dir_meow_state_set "$state_file" hidden true
  fi
}

_dir_meow_label() {
  local state_file=$1

  case $(_dir_meow_mode "$state_file") in
    eza)
      if [[ $(_dir_meow_hidden "$state_file") == true ]]; then
        print -r -- ' eza [hidden] '
      else
        print -r -- ' eza '
      fi
      ;;
    atuin)
      print -r -- ' Atuin '
      ;;
  esac
}

_dir_meow_preview_atuin() {
  local dir=$1

  if (( ! $+commands[atuin] )); then
    print -r -- 'dir-meow: atuin is not installed'
    return 0
  fi

  if [[ -z ${ATUIN_SESSION:-} ]]; then
    print -r -- 'dir-meow: ATUIN_SESSION is not set'
    return 0
  fi

  (
    builtin cd -- "$dir" || return
    command atuin history list --session --cwd --cmd-only
  )
}

_dir_meow_preview_eza() {
  local state_file=$1
  local dir=$2

  if (( ! $+commands[eza] )); then
    print -r -- 'dir-meow: eza is not installed'
    return 0
  fi

  local config_output
  config_output=$(_dir_meow_eza_config) || {
    print -r -- "$config_output"
    return 0
  }

  local -a config
  config=("${(@f)config_output}")

  local icons=$config[1]
  local tree=$config[2]
  local level=$config[3]
  local hidden=$(_dir_meow_hidden "$state_file")

  local -a args
  args=(--oneline --group-directories-first --color=always)

  [[ $hidden == true ]] && args+=(--all)

  # fzf preview output is not necessarily attached directly to a TTY, so make
  # the enabled setting deterministic instead of relying on eza's auto mode.
  [[ $icons == true ]] && args+=(--icons=always)

  if [[ $tree == true ]]; then
    args+=(--tree "--level=$level")
  fi

  command eza "${args[@]}" -- "$dir"
}

case ${1:-} in
  preview)
    (( $# == 3 )) || exit 2
    case $(_dir_meow_mode "$2") in
      eza)   _dir_meow_preview_eza "$2" "$3" ;;
      atuin) _dir_meow_preview_atuin "$3" ;;
    esac
    ;;
  toggle-mode)
    (( $# == 2 )) || exit 2
    _dir_meow_toggle_mode "$2"
    ;;
  toggle-hidden)
    (( $# == 2 )) || exit 2
    _dir_meow_toggle_hidden "$2"
    ;;
  label)
    (( $# == 2 )) || exit 2
    _dir_meow_label "$2"
    ;;
  hidden-default)
    (( $# == 1 )) || exit 2
    config_output=$(_dir_meow_eza_config) || {
      print -r -- "$config_output"
      exit 1
    }
    config=("${(@f)config_output}")
    print -r -- "$config[4]"
    ;;
  *)
    print -u2 -r -- 'usage: dir-meow-preview {preview|toggle-mode|toggle-hidden|label|hidden-default} ...'
    exit 2
    ;;
esac
